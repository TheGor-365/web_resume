#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
[[ -d .git ]] || { echo 'Run only from original git checkout' >&2; exit 1; }
umask 077
mkdir -p .git/career-private
private_file='.git/career-private/mail.env'
if [[ -e "$private_file" ]]; then
  printf 'A private configuration already exists. Overwrite? [y/N] '
  read -r ans
  [[ "$ans" == 'y' || "$ans" == 'Y' ]] || exit 0
fi
printf 'Paste the 16-character Google APP password (input hidden): '
IFS= read -r -s password
printf '\n'
password="${password//[[:space:]]/}"
if [[ ! "$password" =~ ^[A-Za-z0-9]{16}$ ]]; then
  echo 'STOP: expected a 16-character Google app password (not your normal Gmail password).' >&2
  exit 1
fi
printf 'WhatsApp Business number in international format, digits only (Enter to skip): '
read -r wa
wa="${wa//[^0-9]/}"
if [[ -n "$wa" && ! "$wa" =~ ^[1-9][0-9]{7,14}$ ]]; then
  echo 'STOP: number should contain 8–15 digits without +, brackets or spaces.' >&2
  exit 1
fi
{
  printf 'CAREER_GMAIL_APP_PASSWORD=%q\n' "$password"
  if [[ -n "$wa" ]]; then printf 'CAREER_WHATSAPP_PHONE=%q\n' "$wa"; fi
} > "$private_file"
chmod 600 "$private_file"
unset password
printf 'Saved locally inside .git (excluded from GitHub). Run: bin/career-mail-server\n'
