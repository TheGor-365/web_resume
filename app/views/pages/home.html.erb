<section class="site-intro">
  <div class="intro-copy">
    <span class="eyebrow">RUBY ON RAILS · WEB DEVELOPMENT</span>
    <h1><%= t("hero.heading") %></h1>
    <p><%= t("hero.lead") %></p>
    <div class="hero-actions">
      <%= link_to t("hero.projects_cta"), projects_path, class: "btn btn-accent", data: { turbo_stream: true } %>
      <%= link_to "GitHub ↗", "https://github.com/TheGor-365", class: "btn btn-outline-light", target: "_blank", rel: "noopener noreferrer" %>
    </div>
  </div>
  <div class="intro-signal" aria-hidden="true">
    <span class="signal-label">PORTFOLIO / 2026</span>
    <span class="signal-code">&lt;/&gt;</span>
    <span class="signal-label">RAILS · POSTGRESQL · TESTING</span>
  </div>
</section>

<div class="row g-4 portfolio-panels">
  <section class="col-12 col-lg-7">
    <div class="panel-card">
      <div class="profile-top">
        <div>
          <p class="section-kicker"><%= t("hero.profile_label") %></p>
          <h2><%= t("hero.name") %></h2>
          <p class="text-secondary"><%= t("hero.role") %></p>
        </div>
        <%= image_tag "gor.png", alt: t("hero.photo_alt"), class: "profile-photo" %>
      </div>
      <%= render "pages/resume" %>
    </div>
  </section>
  <section class="col-12 col-lg-5">
    <div class="panel-card">
      <%= render "experiences/experience_data" %>
    </div>
  </section>
</div>
<footer class="site-footer">
  <span>© <%= Time.current.year %> Gor Rails · <%= t("footer.disclaimer") %></span>
  <%= link_to "GitHub", "https://github.com/TheGor-365", target: "_blank", rel: "noopener noreferrer" %>
</footer>
