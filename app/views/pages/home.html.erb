<div class="row">
  <div class="col-lg-6 col-md-6 col-sm-10 card shadow rounded p-lg-5 p-md-5 py-5 my-lg-5 my-md-5 my-sm-3 lay me-lg-5 me-md-5" style="max-height:600px; overflow-y:auto;">
    <div class="row align-items-center">
      <div class="col-8">
        <h1><%= t("hero.name") %></h1>
        <p class="text-muted"><%= t("hero.role") %></p>
      </div>
      <div class="col-4">
        <%= image_tag "gor.png", height: 100, width: 100, alt: t("hero.photo_alt"), class: "photo img-fluid float-start", style: "width:100px;height:100px;object-fit:cover;border-radius:50%;" %>
      </div>
    </div>
    <%= render "pages/resume" %>
  </div>

  <div class="col-lg-5 col-md-5 col-sm-10 card shadow rounded p-lg-5 p-md-5 py-5 my-5 lay ms-lg-5 ms-md-5" style="max-height:600px; overflow-y:auto;">
    <%= render "experiences/experience_data" %>
  </div>
</div>
