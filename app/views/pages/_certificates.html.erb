<%= turbo_frame_tag "toggler" do %>
  <h3 class="text-muted"><%= params[:lang] == "en" ? "Certificates" : "Мои сертификаты" %></h3>
  <% if @certificates.any? %>
    <% @certificates.each do |certificate| %>
      <div class="border rounded p-3 my-4 border-success">
        <p class="mb-2"><%= certificate.title %> — <span class="text-success"><%= certificate.school %></span></p>
        <%= image_tag certificate.image, class: "img-fluid", alt: certificate.title, loading: "lazy" if certificate.image.present? %>
      </div>
    <% end %>
  <% else %>
    <p class="text-muted"><%= params[:lang] == "en" ? "Certificates have not been loaded into this database yet." : "Сертификаты пока не загружены в эту базу данных." %></p>
  <% end %>
<% end %>
