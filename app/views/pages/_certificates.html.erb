<%= turbo_frame_tag "toggler" do %>
  <div class="panel-content">
    <h3><%= t("certificates.title") %></h3>
    <p class="muted"><%= t("certificates.intro") %></p>
    <% if @certificates.any? %>
      <div class="certificates-grid">
        <% @certificates.order(title: :asc).each do |certificate| %>
          <article class="certificate-card">
            <h4><%= certificate.title %></h4>
            <p class="muted"><%= certificate.school %></p>
            <% if certificate.image.present? %>
              <%= image_tag certificate.image, class: "img-fluid cert-preview", alt: certificate.title, loading: "lazy" %>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="muted"><%= t("certificates.empty") %></p>
    <% end %>
  </div>
<% end %>
