<%= turbo_frame_tag "toggler" do %>
  <div class="py-sm-5">
    <h3 class="text-muted"><%= t("certificates.title") %></h3>
    <p class="text-muted"><%= t("certificates.intro") %></p>
    <% if @certificates.any? %>
      <div class="row row-cols-1 row-cols-lg-2 g-3">
        <% @certificates.order(Arel.sql("issued_on DESC NULLS LAST, title ASC")).each do |certificate| %>
          <div class="col">
            <article class="border rounded border-success p-3 h-100">
              <h4 class="h6"><%= certificate.title %></h4>
              <p class="text-muted small"><%= certificate.school %><% if certificate.issued_on.present? %> · <%= l(certificate.issued_on, format: "%d.%m.%Y") %><% end %></p>
              <%= image_tag certificate.image, class: "img-fluid rounded", alt: certificate.title, loading: "lazy" if certificate.image.present? %>
            </article>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-muted"><%= t("certificates.empty") %></p>
    <% end %>
  </div>
<% end %>
