<%= turbo_frame_tag "toggler" do %>
  <h3 class="text-muted"><%= t("site.projects.heading") %></h3><br>
  <p class="text-muted small">
    <%= t("site.projects.intro") %>
  </p>

  <% projects = [
    { key: "quality", category_key: "educational", repo_year: "2025", stack: ["Rails 7.2","PostgreSQL","GitHub OAuth","RuboCop","ESLint","Minitest","GitHub Actions"], url: "https://github.com/TheGor-365/rails-project-66" },
    { key: "classifieds", category_key: "educational", repo_year: "2025", stack: ["Rails 7.2","PostgreSQL (prod)","AASM","Pundit","GitHub OAuth","Active Storage","Bootstrap 5"], url: "https://github.com/TheGor-365/rails-project-65" },
    { key: "blog", category_key: "educational", repo_year: "2024", stack: ["Rails 7.2","Devise","I18n","Turbo","Stimulus","Bootstrap","PostgreSQL (prod)"], url: "https://github.com/TheGor-365/rails-project-64" },
    { key: "resume", category_key: "personal", repo_year: "2023", stack: ["Rails 7.0","PostgreSQL","Turbo","Bootstrap 5","Chartkick","Groupdate"], url: "https://github.com/TheGor-365/web_resume" },
    { key: "property", category_key: "early", repo_year: "2020", stack: ["Rails 6","PostgreSQL","Devise","CarrierWave","Action Mailer","Webpacker"], url: "https://github.com/TheGor-365/property_finder" },
    { key: "runner", category_key: "infrastructure", repo_year: "2026", stack: ["GitHub Actions","CI/CD","Workflow automation","Evidence tracking"], url: "https://github.com/TheGor-365/ai-course-actions-runner" }
  ].map do |project|
    key = project.fetch(:key)
    project.merge(
      name: t("site.projects.items.#{key}.name"),
      category: t("site.projects.categories.#{project.fetch(:category_key)}"),
      description: t("site.projects.items.#{key}.description"),
      features: t("site.projects.items.#{key}.features")
    )
  end %>

  <% projects.each do |project| %>
    <article class="border rounded p-3 my-4 border-success">
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <h4 class="h4 text-success mb-0"><%= project[:name] %></h4>
        <span class="badge bg-light text-secondary border"><%= project[:category] %></span>
      </div>
      <%# CAREER_GOR_PROJECT_MEDIA_V1; CAREER_MEDIA_FIT_V2 — responsive artwork. %>
      <p class="small text-muted mb-3"><%= t("site.projects.repo_year") %> <%= project[:repo_year] %></p>
      <% if project[:key] == "quality" %>
        <figure class="career-media-card mb-3 text-center" style="width:100%;max-width:100%;min-width:0;box-sizing:border-box;overflow:hidden;">
          <img src="/media/gor/github-quality.webp" class="career-project-thumb img-fluid d-block mx-auto"
               alt="<%= t("site.projects.quality_art") %>"
               loading="lazy" decoding="async"
               style="display:block;width:auto;max-width:100%;height:auto;max-height:180px;object-fit:contain;">
          <figcaption class="small text-muted mt-2"><%= t("site.projects.quality_caption") %></figcaption>
        </figure>
      <% elsif project[:key] == "resume" %>
        <figure class="career-media-card mb-3 text-center" style="width:100%;max-width:100%;min-width:0;box-sizing:border-box;overflow:hidden;">
          <img src="/media/gor/brand-poster.webp" class="career-project-thumb img-fluid d-block mx-auto"
               alt="<%= t("site.projects.brand_art") %>"
               loading="lazy" decoding="async"
               style="display:block;width:auto;max-width:100%;height:auto;max-height:180px;object-fit:contain;">
          <figcaption class="small text-muted mt-2"><%= t("site.projects.brand_caption") %></figcaption>
        </figure>
      <% end %>
      <p class="mb-3"><%= project[:description] %></p>
      <p class="text-muted fw-semibold mb-1"><%= t("site.projects.features") %></p>
      <ul class="small ps-3 mb-3">
        <% project[:features].each do |feature| %>
          <li class="mb-1"><%= feature %></li>
        <% end %>
      </ul>
      <p class="text-muted fw-semibold mb-2"><%= t("site.projects.technologies") %></p>
      <div class="d-flex flex-wrap gap-1 mb-3">
        <% project[:stack].each do |technology| %>
          <span class="badge bg-light text-dark border fw-normal"><%= technology %></span>
        <% end %>
      </div>
      <%= link_to t("site.projects.code"), project[:url], class: "text-success fw-semibold", target: "_blank", rel: "noopener noreferrer" %>
    </article>
  <% end %>
<% end %>
