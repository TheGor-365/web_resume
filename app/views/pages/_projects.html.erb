<%= turbo_frame_tag "toggler" do %>
  <section class="panel-content">
    <p class="section-overline">03 / SELECTED WORK</p>
    <h2><%= t("projects.title") %></h2>
    <p class="lead-copy"><%= t("projects.note") %></p>
    <div class="project-grid">
      <% portfolio_projects.each_with_index do |project, index| %>
        <article class="project-card">
          <div class="project-card-top">
            <span class="project-number"><%= format("%02d", index + 1) %></span>
            <span class="project-kind"><%= t("site.project_status") %></span>
          </div>
          <h3><%= project.fetch(:name) %></h3>
          <p><%= t("projects.#{project.fetch(:key)}") %></p>
          <p class="project-stack"><%= project.fetch(:stack) %></p>
          <%= link_to "#{t("site.evidence")} ↗", project.fetch(:repo), class: "project-link", target: "_blank", rel: "noopener noreferrer" %>
        </article>
      <% end %>
    </div>
    <p class="subtle-caption"><%= t("site.no_demo") %></p>
  </section>
<% end %>
