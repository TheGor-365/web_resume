<%= turbo_frame_tag "toggler" do %>
  <div class="panel-content">
    <h3><%= t("projects.title") %></h3>
    <p class="muted"><%= t("projects.intro") %></p>
    <% public_portfolio_projects.each do |project| %>
      <article class="project-card">
        <div class="project-heading">
          <span class="project-year"><%= project.fetch(:year) %></span>
          <span class="status-label"><%= t("projects.stages.#{project.fetch(:stage)}") %></span>
        </div>
        <h4><%= project.fetch(:name) %></h4>
        <p><%= portfolio_copy(project) %></p>
        <p class="stack-line"><%= project.fetch(:stack) %></p>
        <%= link_to t("projects.view_code"), project.fetch(:url), target: "_blank", rel: "noopener noreferrer", class: "project-link" %>
      </article>
    <% end %>
  </div>
<% end %>
