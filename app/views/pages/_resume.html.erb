<%= turbo_frame_tag "toggler" do %>
  <section class="panel-content">
    <p class="section-overline">01 / PROFILE</p>
    <h2><%= t("resume.title") %></h2>
    <p class="lead-copy"><%= t("resume.description") %></p>
    <div class="info-block">
      <h3><%= t("resume.work") %></h3>
      <p><%= t("resume.work_value") %></p>
    </div>
    <div class="info-block">
      <h3><%= t("resume.skills") %></h3>
      <div class="skill-tags">
        <% %w[Ruby Rails PostgreSQL REST\ API HTML CSS Bootstrap Git Minitest RSpec Docker].each do |skill| %>
          <span><%= skill.tr("\\", "") %></span>
        <% end %>
      </div>
    </div>
    <div class="info-block">
      <h3><%= t("resume.education") %></h3>
      <p><%= t("resume.education_value") %></p>
    </div>
    <div class="panel-links">
      <%= link_to t("resume.portfolio"), projects_path, data: { turbo_action: "replace" } %>
      <%= link_to t("resume.github_profile"), "https://github.com/TheGor-365", target: "_blank", rel: "noopener noreferrer" %>
    </div>
  </section>
<% end %>
