<%= turbo_frame_tag "toggler" do %>
  <div class="panel-content">
    <h3><%= t("resume.title") %></h3>
    <p class="lead-small"><%= t("resume.summary") %></p>
    <h4><%= t("resume.services_title") %></h4>
    <div class="chip-group">
      <% t("resume.services").each do |item| %><span class="tech-chip"><%= item %></span><% end %>
    </div>
    <h4><%= t("resume.stack_title") %></h4>
    <p class="stack-line">Ruby · Rails · PostgreSQL · HTML · CSS · Bootstrap · Hotwire/Turbo · Git · Minitest/RSpec · REST API</p>
    <h4><%= t("resume.education_title") %></h4>
    <div class="evidence-item">
      <strong><%= t("resume.hexlet_title") %></strong>
      <span class="small muted"><%= t("resume.hexlet_date") %></span>
      <p><%= t("resume.hexlet_note") %></p>
    </div>
    <h4><%= t("resume.workflow_title") %></h4>
    <p><%= t("resume.workflow") %></p>
    <div class="inline-links">
      <%= link_to t("resume.work_link"), "https://github.com/TheGor-365", target: "_blank", rel: "noopener noreferrer" %>
      <%= link_to t("resume.contact_link"), "https://kwork.com/user/thegor-365", target: "_blank", rel: "noopener noreferrer" %>
    </div>
  </div>
<% end %>
