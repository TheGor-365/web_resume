<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= t("site.title") %> | Gor Web Development</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= t("site.tagline") %>">
    <meta name="theme-color" content="#100e24">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header><%= render "layouts/nav" %></header>
    <main id="main-content" class="container site-main">
      <%= yield %>
    </main>
    <footer class="site-footer container">
      <span>© <%= Time.current.year %> Gor Web Development</span>
      <span><%= link_to "GitHub", "https://github.com/TheGor-365", target: "_blank", rel: "noopener noreferrer" %> · <%= link_to "Facebook", "https://www.facebook.com/gor.webdevelopment/", target: "_blank", rel: "noopener noreferrer" %></span>
    </footer>
  </body>
</html>
