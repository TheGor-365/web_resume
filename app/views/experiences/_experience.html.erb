<article class="experience-entry" id="<%= dom_id experience %>">
  <div class="experience-date">
    <%= experience.start_at&.strftime("%Y") || "—" %> — <%= experience.end_at&.strftime("%Y") || "—" %>
  </div>
  <h3><%= localized_role(experience) %></h3>
  <p class="experience-company"><%= experience.company %></p>
  <p><%= localized_overview(experience) %></p>
</article>
