<%= turbo_frame_tag "experience" do %>
  <h1 class="mb-5">Проекты и обучение</h1>

  <% @experiences.each do |experience| %>
    <%= render experience %>
    <hr><br>
  <% end %>

  <div class="shadow rounded p-3 border border-danger">
    <small class="text-muted"><span class="text-dark">Временная шкала</span> — даты создания репозиториев и обучения; не коммерческий стаж</small>
  </div>
<% end %>
