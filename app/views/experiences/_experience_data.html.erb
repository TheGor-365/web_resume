<%= turbo_frame_tag "experience" do %>
  <section class="panel-content">
    <p class="section-overline">05 / CAREER</p>
    <h2><%= t("experience.title") %></h2>
    <% if @experiences.present? %>
      <div class="experience-list">
        <% @experiences.each do |experience| %>
          <%= render "experiences/experience", experience: experience %>
        <% end %>
      </div>
      <p class="subtle-caption"><%= t("experience.past") %></p>
    <% else %>
      <p class="empty-state"><%= t("site.empty_history") %></p>
      <p class="subtle-caption"><%= t("site.private_note") %></p>
    <% end %>
  </section>
<% end %>
