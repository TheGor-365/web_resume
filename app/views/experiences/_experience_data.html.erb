<%= turbo_frame_tag "experience" do %>
  <h1 class="mb-5">Путь в разработке</h1>

  <% @experiences.each do |experience| %>
    <%= render experience %>
    <hr><br>
  <% end %>

  <div class="shadow rounded p-3 border border-danger">
    <small class="text-muted"><span class="text-dark">Хронология</span> — даты создания репозиториев и получения сертификата; это не трудовой стаж</small>
  </div>
<% end %>
