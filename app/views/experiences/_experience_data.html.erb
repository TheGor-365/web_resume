<%= turbo_frame_tag "experience" do %>
  <h1 class="mb-5"><%= t('site.timeline.headings.journey') %></h1>

  <% @experiences.each do |experience| %>
    <%= render experience %>
    <hr><br>
  <% end %>

  <div class="shadow rounded p-3 border border-danger">
    <small class="text-muted"><span class="text-dark"><%= t('site.timeline.notices.journey') %></small>
  </div>
<% end %>
