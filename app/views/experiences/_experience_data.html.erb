<%= turbo_frame_tag "experience" do %>
  <h3 class="text-muted mb-3"><%= t("timeline.title") %></h3>
  <p class="text-muted small"><%= t("timeline.intro") %></p>
  <ol class="list-unstyled border-start border-success ps-3 my-3">
    <% developer_milestones.reverse_each do |milestone| %>
      <li class="border-bottom py-3">
        <small class="text-success fw-bold"><%= milestone.fetch(:year) %></small><br>
        <strong><%= milestone.fetch(:name) %></strong>
        <p class="small text-muted mb-0"><%= milestone_description(milestone) %></p>
      </li>
    <% end %>
  </ol>
  <%= link_to t("timeline.chart_cta"), timeline_path, class: "link-success", data: { turbo_stream: true } %>
<% end %>
