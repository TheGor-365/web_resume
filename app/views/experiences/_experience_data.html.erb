<%= turbo_frame_tag "experience" do %>
  <div class="panel-content">
    <p class="section-kicker"><%= t("timeline.kicker") %></p>
    <h3><%= t("timeline.title") %></h3>
    <p class="muted"><%= t("timeline.intro") %></p>
    <ol class="milestone-list">
      <% developer_milestones.reverse_each do |milestone| %>
        <li class="milestone">
          <span class="milestone-year"><%= milestone.fetch(:year) %></span>
          <div>
            <strong><%= milestone.fetch(:name) %></strong>
            <p><%= milestone_description(milestone) %></p>
          </div>
        </li>
      <% end %>
    </ol>
    <%= link_to t("timeline.chart_cta"), timeline_path, class: "project-link" %>
  </div>
<% end %>
