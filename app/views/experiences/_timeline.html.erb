<%= turbo_frame_tag "experience" do %>
  <h3 class="text-muted mb-3">Хронология разработки</h3>
  <div class="shadow rounded">
    <%= area_chart Experience.public_technical.group_by_year(:start_at).count %>
  </div>

  <h3 class="text-muted mb-3 mt-5">Проекты по направлениям</h3>
  <div class="shadow rounded">
    <%= pie_chart @experiences.group(:title).count %>
  </div>

  <h3 class="text-muted my-5">Данные</h3>
  <% @experiences.each do |experience| %>
    <div class="border rounded p-5 my-5 border border-success bg-white">
      <%= render experience %>
    </div>
  <% end %>
  <div class="shadow rounded p-3 border border-danger">
    <small class="text-muted"><span class="text-dark">Источники данных</span> — даты создания GitHub-репозиториев и сертификата Hexlet</small>
  </div>
<% end %>
