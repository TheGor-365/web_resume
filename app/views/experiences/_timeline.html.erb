<%= turbo_frame_tag "experience" do %>
  <section class="panel-content">
    <p class="section-overline">06 / TIMELINE</p>
    <h2><%= t("experience.timeline") %></h2>
    <% if @experiences.present? %>
      <h3 class="chart-title"><%= t("experience.chart") %></h3>
      <div class="chart-wrap">
        <%= column_chart Experience.group_by_year(:start_at).count, height: "240px", colors: ["#885aff"] %>
      </div>
      <h3 class="chart-title"><%= t("experience.categories") %></h3>
      <div class="chart-wrap">
        <%= pie_chart @experiences.group_by { |record| localized_role(record) }.transform_values(&:length), height: "270px" %>
      </div>
      <p class="subtle-caption"><%= t("experience.past") %></p>
    <% else %>
      <p class="empty-state"><%= t("site.empty_history") %></p>
    <% end %>
  </section>
<% end %>
