<%= turbo_frame_tag "experience" do %>
  <h3 class="text-muted mb-3"><%= t("timeline.chart_title") %></h3>
  <p class="text-muted small"><%= t("timeline.chart_intro") %></p>
  <div class="shadow-sm rounded p-2 bg-white">
    <%= column_chart developer_milestones.group_by { |entry| entry.fetch(:year) }.transform_values(&:count), height: "240px", xtitle: t("timeline.year"), ytitle: t("timeline.count"), colors: ["#198754"] %>
  </div>
  <ol class="list-unstyled mt-4">
    <% developer_milestones.reverse_each do |milestone| %>
      <li class="border-bottom py-2">
        <small class="text-success fw-bold"><%= milestone.fetch(:year) %></small><br>
        <strong><%= milestone.fetch(:name) %></strong>
        <p class="small text-muted mb-0"><%= milestone_description(milestone) %></p>
      </li>
    <% end %>
  </ol>
<% end %>
