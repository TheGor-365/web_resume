<%= turbo_frame_tag "experience" do %>
  <div class="panel-content">
    <h3><%= t("timeline.chart_title") %></h3>
    <p class="muted"><%= t("timeline.chart_intro") %></p>
    <div class="chart-container">
      <%= column_chart developer_milestones.group_by { |entry| entry.fetch(:year) }.transform_values(&:count), height: "240px", xtitle: t("timeline.year"), ytitle: t("timeline.count"), colors: ["#7c3aed"], library: { scales: { y: { beginAtZero: true } } } %>
    </div>
    <ol class="milestone-list mt-4">
      <% developer_milestones.reverse_each do |milestone| %>
        <li class="milestone">
          <span class="milestone-year"><%= milestone.fetch(:year) %></span>
          <div><strong><%= milestone.fetch(:name) %></strong><p><%= milestone_description(milestone) %></p></div>
        </li>
      <% end %>
    </ol>
  </div>
<% end %>
