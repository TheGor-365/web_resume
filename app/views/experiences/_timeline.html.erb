<%= turbo_frame_tag "experience" do %>
  <h3 class="text-muted mb-3"><%= t('site.timeline.headings.yearly') %></h3>
  <div class="shadow rounded">
    <%= area_chart @experiences.reorder(nil).group_by_year(:start_at).count %>
  </div>

  <h3 class="text-muted mb-3 mt-5"><%= t('site.timeline.headings.types') %></h3>
  <div class="shadow rounded">
    <%= pie_chart @experiences.reorder(nil).group(:company).count.transform_keys { |company| portfolio_milestone_category(company) } %>
  </div>

  <h3 class="text-muted my-5"><%= t('site.timeline.headings.events') %></h3>
  <% @experiences.each do |experience| %>
    <div class="border rounded p-5 my-5 border border-success bg-white">
      <%= render experience %>
    </div>
  <% end %>
  <div class="shadow rounded p-3 border border-danger">
    <small class="text-muted"><span class="text-dark"><%= t('site.timeline.notices.metrics') %></small>
  </div>
<% end %>
