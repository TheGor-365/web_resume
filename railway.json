{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": [
      "bin/rails db:prepare",
      "bin/rails career:seed_portfolio"
    ],
    "startCommand": "bin/rails server -b 0.0.0.0",
    "healthcheckPath": "/up",
    "healthcheckTimeout": 120
  }
}
